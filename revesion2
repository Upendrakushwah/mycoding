#include<iostream>
#include<vector>
using namespace std;

int lastOccurrence (vector<int>& arr, int target)
{
       int ans = -1;
   for (int i=0; i<arr.size() ; i++)
   {
       
       if (arr[i] == target);
       {
           
           ans = i ;
       }
   }
       return ans;
    
}
       
int main(){
    vector<int> arr = {24,28,39,47,76,07};
    int target = 07;
    
    int ans = lastOccurrence(arr, target);
    
    if (ans != -1)
    cout << "the last element is: " << ans ;
    
    else 
     cout << "element does not exist";
     
return 0;     
}       
       
       
       
