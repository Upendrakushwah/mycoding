#include <iostream>
#include <vector>
using namespace std;

int Binarysearch (vector<int>& arr, int target)
{
    int left = 0;
    int right = arr.size()-1 ;


    while( left<=right)
    {
        int mid = left + (right-left) / 2;

        if (arr[mid] == target)
        {
            return mid ;
        }

        else if (arr[mid]< target)
        {
            left = mid +1;
        }
        else 
        {
            right = mid-1 ;
        }
    }
    return -1;
}

int main(){

    vector<int> arr = { 2,4,5,6,7,9,10};
    int target = 7;

    int ans = Binarysearch(arr, target);

    cout <<" the ans is: " << ans;

    return 0;

}
