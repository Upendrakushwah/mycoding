#include <iostream>
#include <vector>
using namespace std;

    int linearsearch (vector<int>& arr, int  target)
    {
        for (int i =0; i< arr.size();  i ++)
        {
            if (arr[i]  == target)
            {
            return i;
            }
        }    
        return -1;    
        
    }
    int main()
    
    {
        vector<int> arr = {10,30,50,40,60};
         int target = 50 ;
         int result = linearsearch(arr, target);
         
         if (result != -1) 
             cout << "element found at index : " << result;
         else 
             cout<< " element is  not found" ;
             
         return 0;
    
    }
