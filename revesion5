#include <iostream>
#include <vector>
using namespace std;

int Binarysearch (vector<int>& arr, int target)
{
    int left = 0;
    int right = arr.size()-1 ;


    while( left<=right)
    {
        int mid = left + (right-left) / 2;

        cout <<" checking index: " <<mid 
        << ", element: "<< arr[mid] <<endl;

        if (arr[mid] == target)
        {
            return mid ;
        }

        else if (arr[mid]< target)
        {
            left = mid +1;
        }
        else 
        {
            right = mid-1 ;
        }
    }
    return -1;
}

int main(){

    vector<int> arr = {2, 5, 8, 12, 16, 21, 30, 35, 40 };
    int target = 30;

    int ans = Binarysearch(arr, target);

    cout <<" element found at index : " << ans;


    return 0;

}
