
#include<iostream>
using namespace std;

class Node {
    public:

    int data;
    Node* next;

    Node(int value){
        data = value;
        next = nullptr;
    }


};


void display(Node* head){
    Node* temp = head;

    while (temp != nullptr){
        cout << temp-> data <<" ->";
        temp = temp-> next;
    }

    cout << "NULL" << endl;
}

int main(){
    Node* head  = new Node(20);

    head->next = new Node(30);
    head->next>-next> = new Node(45);

    display(head);

    return 0;
}







